// ============================================================================
// lib.typ — shared library for the AP Psychology knowledge base.
//
// Public API:
//   knowledge(...)     one atomic knowledge entry (used by every unit file)
//   review_entry(...)  the same entry rendered for generated review guides
//   unit_header(...)   banner for a unit section (used by _unit.typ files)
//   theme(...)         page/text theme for the master document (main.typ)
//   base_setup(...)    shared page/paragraph setup (also used by the guide template)
//   styled_headings(.) shared heading show rules (also used by the guide template)
//   chip, difficulty_chip, entry_meta   small building blocks
//   UNIT_NAMES         unit number -> human-readable unit name
//
// CONTRACT with build/build.py:
//   knowledge() emits a #metadata() dictionary labelled <knowledge> carrying
//   every field EXCEPT `body`. The build queries the master with
//   typst.query(master, "<knowledge>", field="value") for that metadata, and
//   reads the raw body text from content_db.json (generated by
//   build/extract_bodies.py). Keep field names in sync with build.py.
//
// CONTENT rules for entry bodies (enforced by build/extract_bodies.py):
//   - write plain Typst markup: paragraphs, "- " bullets, *bold*, _italic_
//   - never use an unescaped "]" (it would close the body content block)
//   - never write "#knowledge(" inside a body or a comment
// ============================================================================

// ---------------------------------------------------------------------------
// Palette (kept in sync with the printed study-guide look)
// ---------------------------------------------------------------------------
#let ink = rgb("1f2933") // main text
#let accent = rgb("1d4e89") // headings, unit banners, entry frames
#let accent_soft = rgb("e9eff7")
#let chip_fill = rgb("eef2f7")
#let chip_ink = rgb("44546a")
#let muted = rgb("6b7280") // small metadata text
#let rule_color = rgb("cbd5e1") // thin divider lines

// ---------------------------------------------------------------------------
// Unit registry (keep in sync with UNIT_NAMES in build/build.py)
// Unit 0 is the teacher's foundational research-design unit; it is assessed
// across all College Board units rather than being an exam unit of its own.
// ---------------------------------------------------------------------------
#let UNIT_NAMES = (
  "Research Design (Research Methods)",
  "Biological Bases of Behavior",
  "Cognition",
  "Development and Learning",
  "Social Psychology and Personality",
  "Mental and Physical Health",
)

// difficulty -> (chip fill, chip text color)
#let difficulty_colors = (
  "core": (fill: rgb("ddefdd"), ink: rgb("1e6b3a")),
  "standard": (fill: rgb("e2ebf8"), ink: rgb("1d4e89")),
  "advanced": (fill: rgb("f9ecd8"), ink: rgb("8a4b08")),
)

// A small rounded chip (used for tags and the difficulty badge).
#let chip(label, fill: chip_fill, ink_c: chip_ink) = box(
  fill: fill,
  radius: 3pt,
  inset: (x: 4.5pt, y: 2pt),
  outset: (y: 2.2pt),
  text(size: 7.5pt, fill: ink_c, label),
)

// Colored badge for the difficulty level of an entry.
#let difficulty_chip(difficulty) = {
  let style = difficulty_colors.at(difficulty, default: (fill: rgb("eeeeee"), ink: rgb("555555")))
  chip(difficulty, fill: style.fill, ink_c: style.ink)
}

// One-line metadata strip shown under every entry heading:
// entry id, unit, difficulty badge, then the tag chips.
#let entry_meta(id, unit, difficulty, tags) = block(above: 0.4em, below: 0.8em)[
  #text(size: 8pt, fill: muted)[
    id: #id #h(6pt) · #h(6pt) Unit #unit — #UNIT_NAMES.at(unit, default: "Unit " + str(unit)) #h(6pt) · #h(6pt)
  ]
  #difficulty_chip(difficulty)
  #if tags.len() > 0 [#h(2pt) #for t in tags [#chip(t) #h(3pt)]]
]

// ---------------------------------------------------------------------------
// knowledge() — the single atomic content primitive.
//
// Every .typ file under units/ calls this exactly once. The trailing content
// block is the entry body (definitions, key terms, examples, misconceptions,
// mnemonics). The metadata dictionary (without the body) is emitted with the
// label <knowledge> so the build pipeline can enumerate the knowledge base.
// ---------------------------------------------------------------------------
#let knowledge(id: "", topic: "", unit: 0, tags: (), difficulty: "core", body) = block(above: 1.5em, below: 1.5em)[
  #metadata((id: id, topic: topic, unit: unit, tags: tags, difficulty: difficulty)) <knowledge>
  #heading(level: 2, topic)
  #entry_meta(id, unit, difficulty, tags)
  #body
  #v(0.55em)
  #line(length: 100%, stroke: 0.5pt + rule_color)
]

// ---------------------------------------------------------------------------
// review_entry() — used by GENERATED review guides (build/build.py output) so
// extracted content keeps the same visual style as the master document.
// ---------------------------------------------------------------------------
#let review_entry(id: "", topic: "", unit: 0, tags: (), difficulty: "core", body) = block(
  width: 100%,
  above: 1.3em,
  below: 1.3em,
  fill: rgb("fbfcfd"),
  stroke: (left: 2.5pt + accent),
  inset: (x: 10pt, y: 7pt),
)[
  #heading(level: 2, topic)
  #entry_meta(id, unit, difficulty, tags)
  #body
]

// ---------------------------------------------------------------------------
// unit_header() — banner for _unit.typ files.
// ---------------------------------------------------------------------------
#let unit_header(number, title, description) = block(above: 1.2em, below: 1em)[
  #heading(level: 1, "Unit " + str(number) + " — " + title)
  #text(size: 9.5pt, fill: muted, description)
]

// ---------------------------------------------------------------------------
// Shared styling used by BOTH the master theme and the review-guide template,
// so extracted entries always look like the master document.
// ---------------------------------------------------------------------------
#let styled_headings(doc_body) = {
  show heading.where(level: 1): it => block(
    above: 1.8em,
    below: 1em,
    width: 100%,
    radius: 4pt,
    fill: accent,
    inset: (x: 11pt, y: 9pt),
  )[#text(fill: white, size: 15pt, weight: "bold", it.body)]
  show heading.where(level: 2): it => block(above: 1.15em, below: 0.6em, width: 100%)[
    #text(size: 12.5pt, weight: "bold", fill: accent, it.body)
    #v(0.12em)
    #line(length: 100%, stroke: 0.6pt + rule_color)
  ]
  doc_body
}

// Base page/paragraph setup (A4 print study guide, serif text, numbered pages).
#let base_setup(doc_body) = {
  set page(paper: "a4", margin: (top: 2.1cm, bottom: 2.2cm, x: 2.2cm), numbering: "1")
  set text(font: "New Computer Modern", size: 10pt, fill: ink, lang: "en")
  set par(justify: true, leading: 0.62em, spacing: 1.05em)
  set list(indent: 0.9em, spacing: 0.62em)
  set heading(numbering: none)
  doc_body
}

// Master document theme. main.typ applies it with `#show: theme`.
#let theme(doc_body) = {
  set document(title: "AP Psychology — Complete Knowledge Base")
  base_setup(styled_headings(doc_body))
}
